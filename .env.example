# Copiar a .env (en esta misma carpeta) y completar. No se sube a git.

# Consultorio (sin defaults: completar con datos reales)
# cómo se presenta el bot: "Soy el asistente de turnos de <CONSULTORIO>"
CONSULTORIO=la Dra. Ejemplo
# motivos de consulta que se ofrecen al sacar turno (JSON, en orden)
MOTIVOS='["Control clínico","Control de estudios","Derivaciones","Completar formulario","Recetas"]'
# sedes y horarios (dom lun mar mie jue vie sab), JSON en una línea entre comillas simples
SEDES='[{"nombre":"Sede Centro","horarios":{"mar":["08:00-16:00"],"jue":["08:00-16:00"]}},{"nombre":"Sede Norte","horarios":{"mie":["09:00-14:00"],"vie":["09:00-14:00"]}}]'
# duración del turno en minutos
TURNO_MIN=45
# ID del Google Calendar (ver GOOGLE.md)
CALENDAR_ID=
# cuántos días hacia adelante se ofrecen turnos
DIAS_ADELANTE=14
# horas que el bot se calla en un chat cuando escribe alguien del consultorio
PAUSA_HORAS=12

# Por defecto el bot usa un menú (árbol de decisión), sin IA. MODO=ia para usar una IA:
MODO=
# IA (solo con MODO=ia): cualquier API compatible con OpenAI (chat/completions con tools)
#   Google AI Studio: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenCode:         LLM_BASE_URL=https://opencode.ai/inference/openai/v1   (sus modelos gratis no sirven fuera de la app de OpenCode)
LLM_BASE_URL=
LLM_API_KEY=
# nombre del modelo tal cual lo lista GET <LLM_BASE_URL>/models
LLM_MODEL=
# JSON de la clave de la cuenta de servicio de Google, en una línea, entre comillas simples (ver GOOGLE.md)
GOOGLE_SA_JSON=

# Candados
# 1 = responde y reserva de verdad; 0 = solo muestra en pantalla lo que haría
BOT_ACTIVO=0
# ej: 2611234567 — si está, el bot solo atiende esos números
BOT_SOLO_TELEFONOS=
# Panel de recordatorios (solo desde esta PC): http://127.0.0.1:PANEL_PUERTO
PANEL_PUERTO=3000
